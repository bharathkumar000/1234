# ==============================================================================
# Eventra 1.0 (IVC-PULSE) Environment Template (.env.example)
# Copy this file to .env or .env.local and fill in the required values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# Obtain from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------

# Project API URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Reference ID (e.g. xyzcompany)
SUPABASE_PROJECT_REF=your-project-ref

# Public Anonymous API Key (Safe to expose to the browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here

# Service Role Secret Key (Server-side ONLY. Never expose to client/git. Bypasses RLS for migrations & backend actions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here
SUPABASE_SECRET_KEY=your-service-role-secret-key-here

# ------------------------------------------------------------------------------
# Security & Checkpoints
# ------------------------------------------------------------------------------

# Secret passcode required for Admin HQ checkpoint verification
ADMIN_PORTAL_SECRET=2026VICEVERSE@IVC

# ------------------------------------------------------------------------------
# External Integrations
# ------------------------------------------------------------------------------

# Public Google Sheets Spreadsheet ID (Used by src/lib/googleSheet.ts for team registration sync)
GOOGLE_SHEETS_SPREADSHEET_ID=10dkiwfcwbv2Qo8CIPjkpOlXJfg2l3yi3uXPKtRrOXEA

# ------------------------------------------------------------------------------
# SEO & Analytics
# ------------------------------------------------------------------------------

# Canonical base URL for production / preview deployments (Used for metadata, sitemaps, and robots)
# Local: http://localhost:3000 | Production: https://eventra-ivc.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 Measurement ID (Optional, format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# Multi-Portal & Runtime Server Configuration
# ------------------------------------------------------------------------------

# Node Environment ('development' or 'production')
NODE_ENV=development

# Server port (default: 3000)
PORT=3000

# Multi-portal base port used by scripts/start-all-portals.mjs
# Port 3000: Admin HQ | Port 3001: Judge Portal | Port 3002: Team Console | Port 3003: Ops Scanner
BASE_PORT=3000

# Base URL used by integration test scripts (scripts/test-all-portals.js)
TEST_BASE_URL=http://localhost:3000

# Disable Next.js anonymous telemetry data collection
NEXT_TELEMETRY_DISABLED=1
