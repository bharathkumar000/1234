# .env.example – copy to .env and fill in the values
# Supabase project & URL configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT_REF=your-project-ref

# Supabase public client configuration (exposed to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase service role / secret key (server‑side only, never shipped to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
SUPABASE_SECRET_KEY=your-service-role-or-secret-key

# Secret used for admin‑portal passcode verification
ADMIN_PORTAL_SECRET=2026VICEVERSE@IVC

# Google Sheets public spreadsheet ID (used for team registration data)
GOOGLE_SHEETS_SPREADSHEET_ID=your-google-sheet-id

# SEO & Analytics (Optional)
NEXT_PUBLIC_SITE_URL=https://eventra-ivc.vercel.app
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional runtime settings
NODE_ENV=development
PORT=3000
BASE_PORT=3000
TEST_BASE_URL=http://localhost:3000
